{
  "name": "@mrk-connect/windows",
  "version": "0.1.0",
  "private": true,
  "description": "MRK Connect Windows desktop companion",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "native:build": "dotnet publish native/MrkInput/MrkInput.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -o native/MrkInput/bin/Release/net8.0-windows",
    "pack": "npm run native:build && electron-builder --dir",
    "dist": "npm run native:build && electron-builder"
  },
  "build": {
    "appId": "com.mrkgraphic.connect",
    "productName": "MRK Connect",
    "files": ["dist/**/*", "renderer/**/*", "package.json"],
    "extraResources": [
      { "from": "native/MrkInput/bin/Release/net8.0-windows", "to": "native", "filter": ["MrkInput.exe"] }
    ],
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "ws": "^8.18.3",
    "@types/ws": "^8.18.1"
  }
}
